From: DockSeed <dockseed@proton.me>
Subject: [PATCH] pinctrl: sunxi: add an A733 r-pinctrl instead of riding the A523's

The board DT already asks for `allwinner,sun60i-a733-r-pinctrl` first and
falls back to `allwinner,sun55i-a523-r-pinctrl`, so today the A523 driver
binds. Patch `arm64-dts-a733-aon-pinctrl-usb-host-vbus` chose that deliberately and checked what it was reusing:
the S_GPIO register geometry is byte-for-byte the A523's (D1 NEW_REG_LAYOUT,
0x30 bank stride, mux @0x00, data @0x10, drive @0x14, pull @0x24), verified
against the A733 user manual.

The withstand voltage registers are not shared. The A523 driver sets
`io_bias_cfg_variant = BIAS_VOLTAGE_PIO_POW_MODE_CTL_INV`: one bit per bank
at position `bank` in the register at 0x340, plus a control register at
0x344. On the A733, SGPIO_POW_MOD_SEL (0x07025340) has two bits per bank,
PL at 1:0 and PM at 3:2 (00 and 10 select 3.3 V, 01 the adaptive mode,
11 1.8 V), and the manual documents no register at 0x344 (A733 User Manual
V1.00, 18.14.7.20). A 3.3 V supply for bank PL would turn PL's 10 into 11,
the 1.8 V mode on a 3.3 V bank, and a supply for bank PM would write into
PL's field.

Give the A733 r-pinctrl its own description without the withstand voltage
handling (`io_bias_cfg_variant` left at BIAS_VOLTAGE_NONE), so that a supply
named for PL or PM in the DT never reaches SGPIO_POW_MOD_SEL. The withstand
voltage of both banks stays as the boot chain set it.

Assisted-by: Claude
---
--- a/drivers/pinctrl/sunxi/Kconfig
+++ b/drivers/pinctrl/sunxi/Kconfig
@@ -136,6 +136,11 @@
 	default ARM64 && ARCH_SUNXI
 	select PINCTRL_SUNXI
 
+config PINCTRL_SUN60I_A733_R
+	bool "Support for the Allwinner A733 R-PIO"
+	default ARM64 && ARCH_SUNXI
+	select PINCTRL_SUNXI
+
 config PINCTRL_SUN55I_A523
 	bool "Support for the Allwinner A523 PIO"
 	default ARM64 && ARCH_SUNXI
--- a/drivers/pinctrl/sunxi/Makefile
+++ b/drivers/pinctrl/sunxi/Makefile
@@ -28,6 +28,7 @@
 obj-$(CONFIG_PINCTRL_SUN50I_H616)	+= pinctrl-sun50i-h616.o
 obj-$(CONFIG_PINCTRL_SUN50I_H616_R)	+= pinctrl-sun50i-h616-r.o
 obj-$(CONFIG_PINCTRL_SUN60I_A733)	+= pinctrl-sun60iw2.o
+obj-$(CONFIG_PINCTRL_SUN60I_A733_R)	+= pinctrl-sun60iw2-r.o
 obj-$(CONFIG_PINCTRL_SUN55I_A523)	+= pinctrl-sun55i-a523.o
 obj-$(CONFIG_PINCTRL_SUN55I_A523_R)	+= pinctrl-sun55i-a523-r.o
 obj-$(CONFIG_PINCTRL_SUN9I_A80)		+= pinctrl-sun9i-a80.o
--- /dev/null
+++ b/drivers/pinctrl/sunxi/pinctrl-sun60iw2-r.c
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Allwinner A733 (sun60iw2) SoC r-pinctrl driver (S_GPIO, banks PL/PM).
+ *
+ * Register geometry is identical to the A523's r-pinctrl (D1 NEW_REG_LAYOUT:
+ * 0x30 bank stride, mux @0x00, data @0x10, drive @0x14, pull @0x24 -- checked
+ * against the UM), which is why the A733 rode the A523 driver
+ * on the fallback compatible until now. The withstand voltage registers are
+ * not identical: the A523 driver writes one bit per bank at 0x0340 and a
+ * control register at 0x0344, while the A733's SGPIO_POW_MOD_SEL (0x0340) has
+ * two bits per bank (PL 1:0, PM 3:2) and the UM documents no register at
+ * 0x0344 (A733 User Manual V1.00, 18.14.7.20).
+ *
+ * This driver does not program the withstand voltage of PL and PM: it stays
+ * as the boot chain set it.
+ *
+ * Based on drivers/pinctrl/sunxi/pinctrl-sun55i-a523-r.c, Copyright (C) 2024 Arm Ltd.
+ * Copyright (c) 2026 DockSeed A733 Debian mainline track
+ */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/of.h>
+#include <linux/of_device.h>
+#include <linux/pinctrl/pinctrl.h>
+
+#include "pinctrl-sunxi.h"
+
+/*
+ * PL0..PL13 and PM0..PM5, from the UM (PL_CFG0/CFG1 defaults
+ * 0xFFFFFFFF/0x00FFFFFF = 14 pins, PM_CFG0 default 0x00FFFFFF = 6 pins) and
+ * the 159-pin mux grid in the UM. Same counts as the
+ * A523.
+ */
+static const u8 a733_r_nr_bank_pins[SUNXI_PINCTRL_MAX_BANKS] =
+/*	  PL  PM */
+	{ 14,  6 };
+
+static const unsigned int a733_r_irq_bank_map[] = { 0, 1 };
+
+static const u8 a733_r_irq_bank_muxes[SUNXI_PINCTRL_MAX_BANKS] =
+/*	  PL  PM */
+	{ 14, 14 };
+
+static struct sunxi_pinctrl_desc a733_r_pinctrl_data = {
+	.irq_banks = ARRAY_SIZE(a733_r_irq_bank_map),
+	.irq_bank_map = a733_r_irq_bank_map,
+	.irq_read_needs_mux = true,
+	.pin_base = PL_BASE,
+};
+
+static int a733_r_pinctrl_probe(struct platform_device *pdev)
+{
+	return sunxi_pinctrl_dt_table_init(pdev, a733_r_nr_bank_pins,
+					   a733_r_irq_bank_muxes,
+					   &a733_r_pinctrl_data,
+					   SUNXI_PINCTRL_NEW_REG_LAYOUT);
+}
+
+static const struct of_device_id a733_r_pinctrl_match[] = {
+	{ .compatible = "allwinner,sun60i-a733-r-pinctrl", },
+	{}
+};
+
+static struct platform_driver a733_r_pinctrl_driver = {
+	.probe	= a733_r_pinctrl_probe,
+	.driver	= {
+		.name		= "sun60i-a733-r-pinctrl",
+		.of_match_table	= a733_r_pinctrl_match,
+	},
+};
+builtin_platform_driver(a733_r_pinctrl_driver);
