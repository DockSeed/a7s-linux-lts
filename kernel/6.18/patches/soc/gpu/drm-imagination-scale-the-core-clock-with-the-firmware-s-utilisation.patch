+/**
+ * pvr_fw_time_corr_rate_changed() - Publish an entry for a new core clock rate
+ * @pvr_dev: Target PowerVR device.
+ *
+ * ROGUE_CR_TIMER counts core clock cycles, so its rate follows the core clock.
+ * The firmware converts a CR delta with the factor of the newest entry, which
+ * was derived from the rate that was set when it was published. After a rate
+ * change a new entry starts at the current CR and OS time with the factor of
+ * the new rate. It starts no earlier than where the firmware's time is, so the
+ * timestamps do not go backwards.
+ *
+ * The entry is taken after the clock switch has returned; until then the
+ * firmware converts with the old factor, which misplaces a timestamp written in
+ * that window by at most the window's length times the relative rate change.
+ *
+ * Does nothing unless the firmware runs. The GPU must be powered, and the
+ * caller must hold &pvr_device.clk_lock.
+ */
+void
+pvr_fw_time_corr_rate_changed(struct pvr_device *pvr_dev)
+{
+	struct pvr_fw_device *fw_dev = &pvr_dev->fw_dev;
+	u64 core_clock_hz = clk_get_rate(pvr_dev->core_clk);
+	u64 cr, os;
+
+	if (WARN_ON(!core_clock_hz))
+		return;
+
+	mutex_lock(&fw_dev->time_corr.lock);
+	if (fw_dev->time_corr.valid) {
+		pvr_fw_time_corr_sample(pvr_dev, &cr, &os);
+		pvr_fw_time_corr_publish(pvr_dev, cr,
+					 max(os, pvr_fw_time_corr_estimate(fw_dev, cr)),
+					 pvr_fw_time_corr_factor(core_clock_hz));
+	}
+	mutex_unlock(&fw_dev->time_corr.lock);
+}
+
+/**
+ * pvr_fw_set_core_clock_speed() - Store the core clock rate for the firmware
+ * @pvr_dev: Target PowerVR device.
+ * @clock_speed_hz: Core clock rate, in Hz.
+ *
+ * The firmware reads SYSINIT's rate when it boots and the runtime config's when
+ * it handles ROGUE_FWIF_KCCB_CMD_CORECLKSPEEDCHANGE. Both are set at creation
+ * only, so a rate that changes later has to be written here.
+ */
+void
+pvr_fw_set_core_clock_speed(struct pvr_device *pvr_dev, u32 clock_speed_hz)
+{
+	struct pvr_fw_device *fw_dev = &pvr_dev->fw_dev;
+
+	WRITE_ONCE(fw_dev->fwif_sysinit->initial_core_clock_speed, clock_speed_hz);
+	WRITE_ONCE(fw_dev->fwif_runtime_cfg->core_clock_speed, clock_speed_hz);
+
+	/* Visible before any command that makes the firmware read them. */
+	wmb();
+}
