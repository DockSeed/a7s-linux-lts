+++ b/drivers/gpu/drm/imagination/pvr_timestamp.c
@@ -0,0 +1,408 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+#include "pvr_timestamp.h"
+
+#include "pvr_cccb.h"
+#include "pvr_device.h"
+#include "pvr_drv.h"
+#include "pvr_fw.h"
+#include "pvr_gem.h"
+#include "pvr_job.h"
+#include "pvr_rogue_fwif.h"
+
+#include <drm/drm_gem.h>
+#include <drm/drm_managed.h>
+#include <linux/align.h>
+#include <linux/bitops.h>
+#include <linux/err.h>
+#include <linux/kref.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/time.h>
+#include <uapi/drm/pvr_drm.h>
+
+/**
+ * struct pvr_timestamp_bo - Firmware mapping of a %DRM_PVR_BO_FW_TIMESTAMPS buffer
+ * @ref: Held by every handle of the buffer and by every job that writes to it.
+ * @pvr_dev: Device the buffer belongs to.
+ * @pvr_obj: The buffer. The firmware mapping keeps it alive.
+ * @fw_obj: The firmware mapping.
+ * @size: Size of the buffer, in bytes.
+ */
+struct pvr_timestamp_bo {
+	struct kref ref;
+	struct pvr_device *pvr_dev;
+	struct pvr_gem_object *pvr_obj;
+	struct pvr_fw_object *fw_obj;
+	size_t size;
+};
+
+/*
+ * The firmware whose PRE_TIMESTAMP and POST_TIMESTAMP handling was measured:
+ * with the timer correlation of pvr_fw_time_corr_start() it writes the time
+ * in ns of the correlation's clock as a u64.
+ */
+static const struct {
+	struct pvr_gpu_id gpu_id;
+	struct pvr_fw_version fw_version;
+} pvr_timestamp_known_fw[] = {
+	{ .gpu_id = { .b = 36, .v = 56, .n = 104, .c = 183 }, .fw_version = { 1, 1 } },
+};
+
+int
+pvr_timestamp_device_init(struct pvr_device *pvr_dev)
+{
+	return drmm_mutex_init(from_pvr_device(pvr_dev), &pvr_dev->timestamps.lock);
+}
+
+/**
+ * pvr_timestamp_supported() - Whether the firmware is known to write job timestamps
+ * @pvr_dev: Target PowerVR device.
+ *
+ * Return: %true for a GPU and firmware version listed in pvr_timestamp_known_fw.
+ */
+bool
+pvr_timestamp_supported(struct pvr_device *pvr_dev)
+{
+	const struct pvr_gpu_id *id = &pvr_dev->gpu_id;
+
+	for (u32 i = 0; i < ARRAY_SIZE(pvr_timestamp_known_fw); i++) {
+		const struct pvr_gpu_id *known = &pvr_timestamp_known_fw[i].gpu_id;
+		const struct pvr_fw_version *ver = &pvr_timestamp_known_fw[i].fw_version;
+
+		if (id->b == known->b && id->v == known->v && id->n == known->n &&
+		    id->c == known->c && pvr_dev->fw_version.major == ver->major &&
+		    pvr_dev->fw_version.minor == ver->minor)
+			return true;
+	}
+
+	return false;
+}
+
+/**
+ * pvr_timestamp_info_get() - Fill &struct drm_pvr_dev_query_timestamp_info
+ * @pvr_dev: Target PowerVR device.
+ * @args: Query arguments.
+ *
+ * Return:
+ *  * 0 on success,
+ *  * -%EOPNOTSUPP if the firmware is not known to write timestamps, or
+ *  * Any error returned by PVR_UOBJ_SET().
+ */
+int
+pvr_timestamp_info_get(struct pvr_device *pvr_dev, struct drm_pvr_ioctl_dev_query_args *args)
+{
+	struct drm_pvr_dev_query_timestamp_info info = {
+		.clock_id = CLOCK_MONOTONIC_RAW,
+		.valid_bits = 64,
+		.bo_max_size = PVR_TIMESTAMP_BO_MAX_SIZE,
+	};
+	int err;
+
+	if (!pvr_timestamp_supported(pvr_dev))
+		return -EOPNOTSUPP;
+
+	if (!args->pointer) {
+		args->size = sizeof(info);
+		return 0;
+	}
+
+	err = PVR_UOBJ_SET(args->pointer, args->size, info);
+	if (err < 0)
+		return err;
+
+	if (args->size > sizeof(info))
+		args->size = sizeof(info);
+
+	return 0;
+}
+
+/**
+ * pvr_timestamp_bo_init() - Map a new %DRM_PVR_BO_FW_TIMESTAMPS buffer for the firmware
+ * @pvr_dev: Target PowerVR device.
+ * @pvr_obj: The new buffer, before it gets a handle.
+ *
+ * The mapping starts with one reference, which pvr_timestamp_bo_init_done()
+ * drops once the buffer has its handle.
+ *
+ * Return:
+ *  * 0 on success,
+ *  * -%EOPNOTSUPP if the firmware is not known to write timestamps,
+ *  * -%EINVAL if the buffer is larger than %PVR_TIMESTAMP_BO_MAX_SIZE,
+ *  * -%ENOSPC if the device's timestamp buffers would exceed
+ *    %PVR_TIMESTAMP_BO_MAX_TOTAL, or
+ *  * Any error returned by pvr_fw_object_map_bo().
+ */
+int
+pvr_timestamp_bo_init(struct pvr_device *pvr_dev, struct pvr_gem_object *pvr_obj)
+{
+	size_t size = pvr_gem_object_size(pvr_obj);
+	struct pvr_timestamp_bo *tbo;
+	int err;
+
+	if (!pvr_timestamp_supported(pvr_dev))
+		return -EOPNOTSUPP;
+
+	if (size > PVR_TIMESTAMP_BO_MAX_SIZE)
+		return -EINVAL;
+
+	tbo = kzalloc_obj(*tbo);
+	if (!tbo)
+		return -ENOMEM;
+
+	mutex_lock(&pvr_dev->timestamps.lock);
+	if (pvr_dev->timestamps.total + size > PVR_TIMESTAMP_BO_MAX_TOTAL) {
+		err = -ENOSPC;
+		goto err_unlock;
+	}
+
+	tbo->fw_obj = pvr_fw_object_map_bo(pvr_dev, pvr_obj);
+	if (IS_ERR(tbo->fw_obj)) {
+		err = PTR_ERR(tbo->fw_obj);
+		goto err_unlock;
+	}
+
+	kref_init(&tbo->ref);
+	tbo->pvr_dev = pvr_dev;
+	tbo->pvr_obj = pvr_obj;
+	tbo->size = size;
+	pvr_dev->timestamps.total += size;
+	pvr_obj->timestamps = tbo;
+	mutex_unlock(&pvr_dev->timestamps.lock);
+
+	return 0;
+
+err_unlock:
+	mutex_unlock(&pvr_dev->timestamps.lock);
+	kfree(tbo);
+
+	return err;
+}
+
+static void
+pvr_timestamp_bo_release(struct kref *ref)
+	__releases(&tbo->pvr_dev->timestamps.lock)
+{
+	struct pvr_timestamp_bo *tbo = container_of(ref, struct pvr_timestamp_bo, ref);
+	struct pvr_device *pvr_dev = tbo->pvr_dev;
+
+	tbo->pvr_obj->timestamps = NULL;
+	pvr_dev->timestamps.total -= tbo->size;
+	mutex_unlock(&pvr_dev->timestamps.lock);
+
+	/* This drops the last reference the driver holds on the buffer. */
+	pvr_fw_object_unmap_bo(tbo->fw_obj);
+	kfree(tbo);
+}
+
+static void
+pvr_timestamp_bo_put(struct pvr_timestamp_bo *tbo)
+{
+	kref_put_mutex(&tbo->ref, pvr_timestamp_bo_release, &tbo->pvr_dev->timestamps.lock);
+}
+
+static struct pvr_timestamp_bo *
+pvr_timestamp_bo_get(struct pvr_gem_object *pvr_obj)
+{
+	struct pvr_device *pvr_dev = to_pvr_device(gem_from_pvr_gem(pvr_obj)->dev);
+	struct pvr_timestamp_bo *tbo;
+
+	mutex_lock(&pvr_dev->timestamps.lock);
+	tbo = pvr_obj->timestamps;
+	if (tbo)
+		kref_get(&tbo->ref);
+	mutex_unlock(&pvr_dev->timestamps.lock);
+
+	return tbo;
+}
+
+/**
+ * pvr_timestamp_bo_init_done() - Drop the reference of pvr_timestamp_bo_init()
+ * @pvr_obj: The buffer, after the attempt to give it a handle.
+ */
+void
+pvr_timestamp_bo_init_done(struct pvr_gem_object *pvr_obj)
+{
+	pvr_timestamp_bo_put(pvr_obj->timestamps);
+}
+
+/**
+ * pvr_timestamp_bo_open() - &drm_gem_object_funcs.open for timestamp buffers
+ * @obj: The buffer.
+ * @file: The file the new handle belongs to.
+ *
+ * Every handle holds the firmware mapping.
+ *
+ * Return: 0, or -%ENOENT if the mapping is already gone.
+ */
+int
+pvr_timestamp_bo_open(struct drm_gem_object *obj, struct drm_file *file)
+{
+	struct pvr_gem_object *pvr_obj = gem_to_pvr_gem(obj);
+
+	if (!(pvr_obj->flags & DRM_PVR_BO_FW_TIMESTAMPS))
+		return 0;
+
+	/* A handle can only be made while another reference holds the mapping. */
+	if (WARN_ON(!pvr_timestamp_bo_get(pvr_obj)))
+		return -ENOENT;
+
+	return 0;
+}
+
+/**
+ * pvr_timestamp_bo_close() - &drm_gem_object_funcs.close for timestamp buffers
+ * @obj: The buffer.
+ * @file: The file the closed handle belonged to.
+ *
+ * The firmware mapping goes when the last handle is closed and no job that
+ * writes to the buffer is left.
+ */
+void
+pvr_timestamp_bo_close(struct drm_gem_object *obj, struct drm_file *file)
+{
+	struct pvr_gem_object *pvr_obj = gem_to_pvr_gem(obj);
+
+	if ((pvr_obj->flags & DRM_PVR_BO_FW_TIMESTAMPS) && !WARN_ON(!pvr_obj->timestamps))
+		pvr_timestamp_bo_put(pvr_obj->timestamps);
+}
+
+static int
+pvr_timestamp_fw_addr(const struct pvr_timestamp_bo *tbo, u64 offset, u32 *fw_addr_out)
+{
+	if (!IS_ALIGNED(offset, sizeof(u64)) || offset > tbo->size - sizeof(u64))
+		return -EINVAL;
+
+	pvr_fw_object_get_fw_addr_offset(tbo->fw_obj, offset, fw_addr_out);
+
+	return 0;
+}
+
+static int
+pvr_timestamp_job_check_unused(const struct drm_pvr_job *args)
+{
+	if (args->timestamp_bo_handle || args->timestamp_pre_offset ||
+	    args->timestamp_post_offset)
+		return -EINVAL;
+
+	return 0;
+}
+
+/**
+ * pvr_timestamp_job_init() - Set up the timestamps a job asks for
+ * @job: The job being created.
+ * @pvr_file: The file submitting the job.
+ * @args: The job's arguments.
+ *
+ * Return:
+ *  * 0 on success,
+ *  * -%EOPNOTSUPP if the firmware is not known to write timestamps, or
+ *  * -%EINVAL if the arguments are invalid.
+ */
+int
+pvr_timestamp_job_init(struct pvr_job *job, struct pvr_file *pvr_file,
+		       const struct drm_pvr_job *args)
+{
+	u32 flags = args->timestamp_flags;
+	struct pvr_gem_object *pvr_obj;
+	int err;
+
+	if (!flags)
+		return pvr_timestamp_job_check_unused(args);
+
+	if (flags & ~DRM_PVR_SUBMIT_JOB_TIMESTAMP_FLAGS_MASK)
+		return -EINVAL;
+
+	if (!pvr_timestamp_supported(job->pvr_dev))
+		return -EOPNOTSUPP;
+
+	pvr_obj = pvr_gem_object_from_handle(pvr_file, args->timestamp_bo_handle);
+	if (!pvr_obj)
+		return -EINVAL;
+
+	job->timestamps = pvr_timestamp_bo_get(pvr_obj);
+	pvr_gem_object_put(pvr_obj);
+	if (!job->timestamps)
+		return -EINVAL;
+
+	job->timestamp_flags = flags;
+	err = 0;
+	if (flags & DRM_PVR_SUBMIT_JOB_TIMESTAMP_PRE)
+		err = pvr_timestamp_fw_addr(job->timestamps, args->timestamp_pre_offset,
+					    &job->timestamp_fw_addr[0]);
+	else if (args->timestamp_pre_offset)
+		err = -EINVAL;
+
+	if (!err && (flags & DRM_PVR_SUBMIT_JOB_TIMESTAMP_POST))
+		err = pvr_timestamp_fw_addr(job->timestamps, args->timestamp_post_offset,
+					    &job->timestamp_fw_addr[1]);
+	else if (!err && args->timestamp_post_offset)
+		err = -EINVAL;
+
+	return err;
+}
+
+/**
+ * pvr_timestamp_job_fini() - Release what pvr_timestamp_job_init() took
+ * @job: The job being released.
+ */
+void
+pvr_timestamp_job_fini(struct pvr_job *job)
+{
+	if (job->timestamps)
+		pvr_timestamp_bo_put(job->timestamps);
+
+	job->timestamps = NULL;
+}
+
+static u32
+pvr_timestamp_cmd_size(void)
+{
+	return pvr_cccb_get_size_of_cmd_with_hdr(sizeof(struct rogue_fwif_ccb_cmd_timestamp));
+}
+
+/**
+ * pvr_timestamp_job_cmds_size() - CCB space the job's timestamp commands take
+ * @job: Target job.
+ *
+ * Return: The size in bytes.
+ */
+u32
+pvr_timestamp_job_cmds_size(const struct pvr_job *job)
+{
+	return hweight32(job->timestamp_flags) * pvr_timestamp_cmd_size();
+}
+
+static void
+pvr_timestamp_write(struct pvr_cccb *cccb, u32 cmd_type, u32 fw_addr)
+{
+	struct rogue_fwif_ccb_cmd_timestamp cmd = { .addr = fw_addr };
+
+	pvr_cccb_write_command_with_header(cccb, cmd_type, sizeof(cmd), &cmd, 0, 0);
+}
+
+/**
+ * pvr_timestamp_job_write_pre() - Write the command for the timestamp before the job
+ * @job: Target job.
+ * @cccb: The job's client CCB, right before the job's command.
+ */
+void
+pvr_timestamp_job_write_pre(const struct pvr_job *job, struct pvr_cccb *cccb)
+{
+	if (job->timestamp_flags & DRM_PVR_SUBMIT_JOB_TIMESTAMP_PRE)
+		pvr_timestamp_write(cccb, ROGUE_FWIF_CCB_CMD_TYPE_PRE_TIMESTAMP,
+				    job->timestamp_fw_addr[0]);
+}
+
+/**
+ * pvr_timestamp_job_write_post() - Write the command for the timestamp after the job
+ * @job: Target job.
+ * @cccb: The job's client CCB, right after the job's command.
+ */
+void
+pvr_timestamp_job_write_post(const struct pvr_job *job, struct pvr_cccb *cccb)
+{
+	if (job->timestamp_flags & DRM_PVR_SUBMIT_JOB_TIMESTAMP_POST)
+		pvr_timestamp_write(cccb, ROGUE_FWIF_CCB_CMD_TYPE_POST_TIMESTAMP,
+				    job->timestamp_fw_addr[1]);
+}
