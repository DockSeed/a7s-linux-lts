+/**
+ * pvr_fw_object_map_bo() - Map a userspace buffer object in firmware address space
+ * @pvr_dev: Device pointer.
+ * @pvr_obj: Buffer object to map.
+ *
+ * Unlike the other FW objects, the returned object is not initialised or
+ * cleared on hard reset, and it does not hold a reference to @pvr_obj: the
+ * firmware mapping does, until pvr_fw_object_unmap_bo().
+ *
+ * Returns:
+ *  * The FW object on success, or
+ *  * Any error returned by pvr_fw_object_fw_map().
+ */
+struct pvr_fw_object *
+pvr_fw_object_map_bo(struct pvr_device *pvr_dev, struct pvr_gem_object *pvr_obj)
+{
+	struct pvr_fw_object *fw_obj;
+	int err;
+
+	fw_obj = kzalloc_obj(*fw_obj);
+	if (!fw_obj)
+		return ERR_PTR(-ENOMEM);
+
+	INIT_LIST_HEAD(&fw_obj->node);
+	fw_obj->gem = pvr_obj;
+
+	err = pvr_fw_object_fw_map(pvr_dev, fw_obj, 0);
+	if (err) {
+		kfree(fw_obj);
+		return ERR_PTR(err);
+	}
+
+	return fw_obj;
+}
+
+/**
+ * pvr_fw_object_unmap_bo() - Undo pvr_fw_object_map_bo()
+ * @fw_obj: FW object returned by pvr_fw_object_map_bo().
+ */
+void
+pvr_fw_object_unmap_bo(struct pvr_fw_object *fw_obj)
+{
+	WARN_ON(pvr_fw_object_fw_unmap(fw_obj));
+	kfree(fw_obj);
+}
