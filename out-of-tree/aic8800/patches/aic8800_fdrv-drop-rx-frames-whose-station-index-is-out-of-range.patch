From: DockSeed <dockseed@proton.me>
Subject: [PATCH] aic8800_fdrv: drop rx frames whose station index is out of
 range

hw_rxhdr->flags_sta_idx and flags_dst_idx are 8-bit values from the
device; 0xff (RWNX_INVALID_STA) means no station. Any other value is
used as an index into rwnx_hw->sta_table[] (NX_REMOTE_STA_MAX +
NX_VIRT_DEV_MAX entries) in rwnx_rxdataind_aicwf(), for statistics, RSSI
(writes), the vlan lookup, forwarding and the reorder path. An index
from the table size up to 0xfe reads and writes past the table.

Check both indexes once in rwnx_rxdataind_aicwf(), where every data frame
enters. A frame with an index out of range is dropped and counted in
rx_bad_frame_drops.

Assisted-by: Claude

diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_rx.c b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_rx.c
index c5c53fa..a3084a5 100644
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_rx.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_rx.c
@@ -2274,6 +2274,19 @@ u8 rwnx_rxdataind_aicwf(struct rwnx_hw *rwnx_hw, void *hostid, void *rx_priv)
     REG_SW_SET_PROFILING(rwnx_hw, SW_PROF_RWNXDATAIND);
     hw_rxhdr = (struct hw_rxhdr *)skb->data;
 
+    /* flags_sta_idx and flags_dst_idx are 8-bit fields from the device and
+     * index sta_table[] (NX_REMOTE_STA_MAX + NX_VIRT_DEV_MAX entries) all
+     * through this function, the reorder and the forwarding paths, some of
+     * them for writing. 0xff (RWNX_INVALID_STA) means "no station". */
+    if ((hw_rxhdr->flags_sta_idx != RWNX_INVALID_STA &&
+         hw_rxhdr->flags_sta_idx >= ARRAY_SIZE(rwnx_hw->sta_table)) ||
+        (hw_rxhdr->flags_dst_idx != RWNX_INVALID_STA &&
+         hw_rxhdr->flags_dst_idx >= ARRAY_SIZE(rwnx_hw->sta_table))) {
+        rx_bad_frame_drops++;
+        dev_kfree_skb(skb);
+        goto end;
+    }
+
 #ifdef AICWF_RX_REORDER
     if(hw_rxhdr->is_monitor_vif) {
         status = RX_STAT_MONITOR;
