From: DockSeed <dockseed@proton.me>
Subject: [PATCH] Build the aic8800 USB driver against Linux 6.18

Remaining build problems on 6.18 after the version guards that tag
5.0+git20260123.5f7be68d-8 already has:

- rwnx_cfg80211_get_tx_power() uses the pre-6.14 prototype. 6.18 expects
  (wiphy, wdev, int radio_idx, unsigned int link_id, int *dbm). Add
  the two parameters; both are ignored.
- Four call sites in code this build does not compile still use removed
  timer APIs: three in aicwf_sdio.c (CONFIG_SDIO_SUPPORT is off) and one
  del_timer_sync() inside #if 0 in rwnx_cfg80211_del_iface(). Use
  timer_delete(), timer_delete_sync() and timer_container_of().

The CAC cancel reporting in rwnx_radar_cancel_cac() is not changed.

Assisted-by: Claude

diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/aicwf_sdio.c b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/aicwf_sdio.c
index f8e79cc..d154a5c 100644
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/aicwf_sdio.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/aicwf_sdio.c
@@ -527,7 +527,7 @@ static void aicwf_sdio_bus_stop(struct device *dev)
 
     aicwf_sdio_pwrctl_timer(sdiodev, 0);
     if(timer_pending(&sdiodev->rwnx_hw->p2p_alive_timer)){
-        ret = del_timer(&sdiodev->rwnx_hw->p2p_alive_timer);}
+        ret = timer_delete(&sdiodev->rwnx_hw->p2p_alive_timer);}
     sdio_dbg("%s\n",__func__);
     if (sdiodev->pwrctl_tsk) {
         complete(&sdiodev->pwrctrl_trgg);
@@ -997,7 +997,7 @@ static void aicwf_sdio_bus_pwrctl(struct timer_list *t)
 #if LINUX_VERSION_CODE < KERNEL_VERSION(4,14,0)
     struct aic_sdio_dev *sdiodev = (struct aic_sdio_dev *) data;
 #else
-    struct aic_sdio_dev *sdiodev = from_timer(sdiodev, t, timer);
+    struct aic_sdio_dev *sdiodev = timer_container_of(sdiodev, t, timer);
 #endif
 
     if (sdiodev->bus_if->state == BUS_DOWN_ST) {
@@ -1080,7 +1080,7 @@ void aicwf_sdio_pwrctl_timer(struct aic_sdio_dev *sdiodev, uint duration)
     spin_lock_bh(&sdiodev->pwrctl_lock);
     if (!duration) {
         if (timer_pending(&sdiodev->timer))
-            del_timer_sync(&sdiodev->timer);
+            timer_delete_sync(&sdiodev->timer);
     } else {
         sdiodev->active_duration = duration;
         timeout = msecs_to_jiffies(sdiodev->active_duration);
diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c
index 82df70b..e670259 100644
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c
@@ -2587,7 +2587,7 @@ static int rwnx_cfg80211_del_iface(struct wiphy *wiphy, struct wireless_dev *wde
 #if 0
 	if (rwnx_vif == rwnx_hw->p2p_dev_vif) {
 		if (timer_pending(&rwnx_hw->p2p_alive_timer)) {
-			del_timer_sync(&rwnx_hw->p2p_alive_timer);
+			timer_delete_sync(&rwnx_hw->p2p_alive_timer);
 		}
 	}
 #endif
@@ -4514,6 +4514,7 @@ static int rwnx_cfg80211_get_tx_power(struct wiphy *wiphy,
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(3, 8, 0)
  struct wireless_dev *wdev,
 #endif
+ int radio_idx, unsigned int link_id,
 	int *mbm)
 {
     #if LINUX_VERSION_CODE < KERNEL_VERSION(3, 8, 0)
