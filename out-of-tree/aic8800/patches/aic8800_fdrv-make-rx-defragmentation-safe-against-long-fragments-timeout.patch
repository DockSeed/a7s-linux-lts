From: DockSeed <dockseed@proton.me>
Subject: [PATCH] aic8800_fdrv: make rx defragmentation safe against long
 fragments, timeout

Host-side rx defragmentation in rwnx_rxdataind_aicwf() keeps a 2000-byte
skb per sequence number on defrag_list under defrag_lock, with a 40 ms
timer per entry. Problems:
- The first fragment allocates with GFP_KERNEL under spin_lock_bh().
- Fragments are not checked against the 2000 bytes (skb_over_panic) or
  their header length (negative length to skb_put()).
- defrag_timeout_cb() unlocks through the entry it has just freed, and
  the last fragment frees an entry a timeout may still use.
- rwnx_cfg80211_deinit() frees the list cursor inside
  list_for_each_entry() and calls timer_delete_sync() under defrag_lock.
Use GFP_ATOMIC and drop fragments that exceed the tailroom or are
shorter than their header. Whoever unlists an entry (under the lock)
frees it, after timer_delete_sync() with the lock dropped; the timeout
returns if the entry is unlisted.

Assisted-by: Claude

diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c
index d886f56..0afe586 100644
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c
@@ -9368,19 +9368,20 @@ void rwnx_cfg80211_deinit(struct rwnx_hw *rwnx_hw)
 
 
     spin_lock_bh(&rwnx_hw->defrag_lock);
-    if (!list_empty(&rwnx_hw->defrag_list)) {
-        list_for_each_entry(defrag_ctrl, &rwnx_hw->defrag_list, list) {
-            list_del_init(&defrag_ctrl->list);
-            if (timer_pending(&defrag_ctrl->defrag_timer)) {
+    while (!list_empty(&rwnx_hw->defrag_list)) {
+        defrag_ctrl = list_first_entry(&rwnx_hw->defrag_list,
+                                       struct defrag_ctrl_info, list);
+        list_del_init(&defrag_ctrl->list);
+        /* The timeout takes this lock: stop it with the lock dropped. */
+        spin_unlock_bh(&rwnx_hw->defrag_lock);
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 15, 0))
-                timer_delete_sync(&defrag_ctrl->defrag_timer);
+        timer_delete_sync(&defrag_ctrl->defrag_timer);
 #else
-                del_timer_sync(&defrag_ctrl->defrag_timer);
+        del_timer_sync(&defrag_ctrl->defrag_timer);
 #endif
-	    }
-            dev_kfree_skb(defrag_ctrl->skb);
-            kfree(defrag_ctrl);
-        }
+        dev_kfree_skb(defrag_ctrl->skb);
+        kfree(defrag_ctrl);
+        spin_lock_bh(&rwnx_hw->defrag_lock);
     }
     spin_unlock_bh(&rwnx_hw->defrag_lock);
 
diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_rx.c b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_rx.c
index 3fef04d..572bca4 100644
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_rx.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_rx.c
@@ -2217,6 +2217,7 @@ void defrag_timeout_cb(struct timer_list *t)
 #endif
 {
 	struct defrag_ctrl_info *defrag_ctrl = NULL;
+	struct rwnx_hw *rwnx_hw;
 #if LINUX_VERSION_CODE < KERNEL_VERSION(4, 15, 0)
 	defrag_ctrl = (struct defrag_ctrl_info *)data;
 #elif LINUX_VERSION_CODE < KERNEL_VERSION(6,16,0)
@@ -2226,11 +2227,18 @@ void defrag_timeout_cb(struct timer_list *t)
 #endif
 
 	printk("%s:%p\r\n", __func__, defrag_ctrl);
-	spin_lock_bh(&defrag_ctrl->rwnx_hw->defrag_lock);
+	rwnx_hw = defrag_ctrl->rwnx_hw;
+	spin_lock_bh(&rwnx_hw->defrag_lock);
+	/* Whoever takes it off defrag_list frees it: the last fragment or the
+	 * deinit may have done so already and wait for us to return. */
+	if (list_empty(&defrag_ctrl->list)) {
+		spin_unlock_bh(&rwnx_hw->defrag_lock);
+		return;
+	}
 	list_del_init(&defrag_ctrl->list);
+	spin_unlock_bh(&rwnx_hw->defrag_lock);
 	dev_kfree_skb(defrag_ctrl->skb);
 	kfree(defrag_ctrl);
-	spin_unlock_bh(&defrag_ctrl->rwnx_hw->defrag_lock);
 }
 
 extern void rwnx_data_dump(char* tag, void* data, unsigned long len);
@@ -2608,6 +2616,13 @@ check_len_update:
 							spin_unlock_bh(&rwnx_hw->defrag_lock);
 							return 0;
 						}
+						if (skb->len < pull_len - 8 ||
+						    skb->len - (pull_len - 8) > skb_tailroom(defrag_info->skb)) {
+							printk("defrag overflow:%d,%d\n", defrag_info->frm_len, skb->len);
+							dev_kfree_skb(skb);
+							spin_unlock_bh(&rwnx_hw->defrag_lock);
+							return 0;
+						}
 
 						skb_put(defrag_info->skb, skb->len-(pull_len-8));
 						memcpy(&defrag_info->skb->data[defrag_info->frm_len], \
@@ -2619,14 +2634,14 @@ check_len_update:
 						spin_unlock_bh(&rwnx_hw->defrag_lock);
 						return 0;
 					} else {
-						defrag_info = kzalloc(sizeof(struct defrag_ctrl_info), GFP_KERNEL);
+						defrag_info = kzalloc(sizeof(struct defrag_ctrl_info), GFP_ATOMIC);
 						if (defrag_info == NULL) {
 							printk("no defrag_ctrl_info\r\n");
 							dev_kfree_skb(skb);
 							spin_unlock_bh(&rwnx_hw->defrag_lock);
 							return 0;
 						}
-						defrag_info->skb = __dev_alloc_skb(2000, GFP_KERNEL);
+						defrag_info->skb = __dev_alloc_skb(2000, GFP_ATOMIC);
 						if (defrag_info->skb == NULL) {
 							printk("no fragment skb\r\n");
 							dev_kfree_skb(skb);
@@ -2644,14 +2659,20 @@ check_len_update:
 						defrag_info->next_fn = 1;
 						defrag_info->tid = tid;
 						defrag_info->sta_idx = sta_idx;
+						if (skb->len > skb_tailroom(defrag_info->skb)) {
+							printk("defrag overflow:0,%d\n", skb->len);
+							dev_kfree_skb(defrag_info->skb);
+							kfree(defrag_info);
+							dev_kfree_skb(skb);
+							spin_unlock_bh(&rwnx_hw->defrag_lock);
+							return 0;
+						}
 
 						skb_put(defrag_info->skb, skb->len);
 						memcpy(defrag_info->skb->data, skb->data, skb->len);
 						defrag_info->frm_len = skb->len;
 						defrag_info->rwnx_hw = rwnx_hw;
 						//printk("first:%p,%p,%p,%p,%p, %d,%d\r\n", defrag_info, defrag_info->skb, defrag_info->skb->head, defrag_info->skb->tail, defrag_info->skb->end, defrag_info->frm_len, skb->len);
-						list_add_tail(&defrag_info->list, &rwnx_hw->defrag_list);
-						spin_unlock_bh(&rwnx_hw->defrag_lock);
 #if LINUX_VERSION_CODE < KERNEL_VERSION(4, 15, 0)
 						init_timer(&defrag_info->defrag_timer);
 						defrag_info->defrag_timer.data = (unsigned long)defrag_info;
@@ -2659,6 +2680,8 @@ check_len_update:
 #else
 						timer_setup(&defrag_info->defrag_timer, defrag_timeout_cb, 0);
 #endif
+						list_add_tail(&defrag_info->list, &rwnx_hw->defrag_list);
+						spin_unlock_bh(&rwnx_hw->defrag_lock);
 						ret = mod_timer(&defrag_info->defrag_timer, jiffies + msecs_to_jiffies(DEFRAG_MAX_WAIT));
 						dev_kfree_skb(skb);
 						return 0;
@@ -2684,6 +2707,13 @@ check_len_update:
 								spin_unlock_bh(&rwnx_hw->defrag_lock);
 								return 0;
 							}
+							if (skb->len < pull_len - 8 ||
+							    skb->len - (pull_len - 8) > skb_tailroom(defrag_info->skb)) {
+								printk("defrag overflow:%d,%d\n", defrag_info->frm_len, skb->len);
+								dev_kfree_skb(skb);
+								spin_unlock_bh(&rwnx_hw->defrag_lock);
+								return 0;
+							}
 
 							skb_put(defrag_info->skb, skb->len - (pull_len-8));
 							memcpy(&defrag_info->skb->data[defrag_info->frm_len], \
@@ -2703,15 +2733,14 @@ check_len_update:
 
 							skb_tmp = defrag_info->skb;
 							list_del_init(&defrag_info->list);
-							if (timer_pending(&defrag_info->defrag_timer)) {
+							spin_unlock_bh(&rwnx_hw->defrag_lock);
+							/* Off the list, so a timeout that runs now leaves it to us. */
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 15, 0))
-								ret = timer_delete(&defrag_info->defrag_timer);
+							timer_delete_sync(&defrag_info->defrag_timer);
 #else
-								ret = del_timer(&defrag_info->defrag_timer);
+							del_timer_sync(&defrag_info->defrag_timer);
 #endif
-							}
 							kfree(defrag_info);
-							spin_unlock_bh(&rwnx_hw->defrag_lock);
 
 							if (!rwnx_rx_data_skb(rwnx_hw, rwnx_vif, skb_tmp, hw_rxhdr))
 								dev_kfree_skb(skb_tmp);
