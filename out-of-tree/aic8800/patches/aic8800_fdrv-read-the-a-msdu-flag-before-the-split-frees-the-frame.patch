From: DockSeed <dockseed@proton.me>
Subject: [PATCH] aic8800_fdrv: read the A-MSDU flag before the split frees the
 frame

In station mode, rwnx_rxdataind_aicwf() passes a data frame to
rwnx_rx_data_skb() and then tests hw_rxhdr->flags_is_amsdu to decide
whether to free it. hw_rxhdr points into the skb, and for an A-MSDU
rwnx_rx_data_skb() splits the frame with rwnx_rxdata_process_amsdu(),
which frees that skb. The flag is then read from freed memory, once per
received A-MSDU.

Read the flag into a local variable before the call.

Assisted-by: Claude

diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_rx.c b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_rx.c
index 572d370..3fef04d 100644
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_rx.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_rx.c
@@ -2261,6 +2261,7 @@ u8 rwnx_rxdataind_aicwf(struct rwnx_hw *rwnx_hw, void *hostid, void *rx_priv)
     u8 sta_idx = 0;
     u16_l frame_ctrl;
     u8 is_amsdu = 0;
+    u8 amsdu_frame = 0;
     bool resend = false, forward = true;
     const struct ethhdr *eth;
 #ifdef CONFIG_SUPPORT_4ADDR
@@ -2790,10 +2791,14 @@ check_len_update:
     				reord_process_unit(pframe, (struct aicwf_rx_priv *)rx_priv, skb, seq_num, tid, 1, hw_rxhdr->flags_is_amsdu);
                 } else if (is_qos  && !hw_rxhdr->flags_need_reord) {
                     reord_flush_tid((struct aicwf_rx_priv *)rx_priv, skb, tid);
-                    if (!rwnx_rx_data_skb(rwnx_hw, rwnx_vif, skb, hw_rxhdr) && !hw_rxhdr->flags_is_amsdu)
+                    /* hw_rxhdr lies in skb, which the A-MSDU split in
+                     * rwnx_rx_data_skb() frees: read the flag first. */
+                    amsdu_frame = hw_rxhdr->flags_is_amsdu;
+                    if (!rwnx_rx_data_skb(rwnx_hw, rwnx_vif, skb, hw_rxhdr) && !amsdu_frame)
                         dev_kfree_skb(skb);
                 } else {
-                    if (!rwnx_rx_data_skb(rwnx_hw, rwnx_vif, skb, hw_rxhdr) && !hw_rxhdr->flags_is_amsdu)
+                    amsdu_frame = hw_rxhdr->flags_is_amsdu;
+                    if (!rwnx_rx_data_skb(rwnx_hw, rwnx_vif, skb, hw_rxhdr) && !amsdu_frame)
                         dev_kfree_skb(skb);
                 }
 	        } else if( (rwnx_vif->wdev.iftype == NL80211_IFTYPE_AP) || (rwnx_vif->wdev.iftype == NL80211_IFTYPE_P2P_GO) ) {
