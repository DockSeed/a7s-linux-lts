index c98c4cf..a52adc6 100644
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_msg_rx.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_msg_rx.c
@@ -30,6 +30,30 @@
 #endif
 #include "rwnx_msg_rx.h"
 
+extern uint rx_unknown_msgs;
+extern uint rx_bad_frame_drops;
+
+/* Messages from the firmware name interfaces and stations by index. An
+ * index past the table is counted and gives NULL, so the handler drops
+ * the message instead of reading or writing behind the table. */
+static struct rwnx_vif *rwnx_msg_vif(struct rwnx_hw *rwnx_hw, unsigned int idx)
+{
+    if (idx >= ARRAY_SIZE(rwnx_hw->vif_table)) {
+        rx_bad_frame_drops++;
+        return NULL;
+    }
+    return rwnx_hw->vif_table[idx];
+}
+
+static struct rwnx_sta *rwnx_msg_sta(struct rwnx_hw *rwnx_hw, unsigned int idx)
+{
+    if (idx >= ARRAY_SIZE(rwnx_hw->sta_table)) {
+        rx_bad_frame_drops++;
+        return NULL;
+    }
+    return &rwnx_hw->sta_table[idx];
+}
+
 void rwnx_cfg80211_unlink_bss(struct rwnx_hw *rwnx_hw, struct rwnx_vif *rwnx_vif);
 
